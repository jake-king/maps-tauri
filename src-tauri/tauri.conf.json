{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "maps-tauri",
  "version": "0.1.0",
  "identifier": "local.maps-tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
